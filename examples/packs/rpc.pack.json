{
  "version": 1,
  "name": "rpc_demo",
  "description": "Isolated rpc integration fixture",
  "bindings": {
    "detail": "detail",
    "decide": "decide"
  },
  "reads": [
    {
      "name": "read",
      "description": "Read and normalize a record; compute total from rows.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "steps": [
        {
          "id": "before",
          "operation": "detail",
          "arguments": {
            "body": {
              "method": "task.get",
              "params": {
                "key": {
                  "$arg": "/id"
                }
              }
            }
          },
          "assertions": [
            {
              "pointer": "/data/result/key",
              "op": "eq",
              "value": {
                "$arg": "/id"
              }
            }
          ]
        }
      ],
      "output": {
        "id": {
          "$step": "before",
          "pointer": "/data/result/key"
        },
        "status": {
          "$step": "before",
          "pointer": "/data/result/phase"
        },
        "total": {
          "$fn": "sum",
          "args": [
            {
              "$map": {
                "$step": "before",
                "pointer": "/data/result/items"
              },
              "value": {
                "$fn": "multiply",
                "args": [
                  {
                    "$item": "/quantity"
                  },
                  {
                    "$item": "/price"
                  }
                ]
              }
            }
          ]
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "status",
          "total"
        ],
        "additionalProperties": false
      }
    }
  ],
  "contracts": [
    {
      "version": 1,
      "name": "approve",
      "description": "Approve an isolated test record with calculated fields.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "note": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "note",
          "start"
        ],
        "additionalProperties": false
      },
      "preflight": [
        {
          "id": "before",
          "operation": "detail",
          "arguments": {
            "body": {
              "method": "task.get",
              "params": {
                "key": {
                  "$arg": "/id"
                }
              }
            }
          },
          "assertions": [
            {
              "pointer": "/data/result/key",
              "op": "eq",
              "value": {
                "$arg": "/id"
              }
            },
            {
              "pointer": "/data/result/phase",
              "op": "eq",
              "value": "pending"
            }
          ],
          "pin": [
            "/data/result"
          ]
        }
      ],
      "write": {
        "operation": "decide",
        "arguments": {
          "body": {
            "method": "task.decide",
            "params": {
              "key": {
                "$arg": "/id"
              },
              "decision": "approved",
              "note": {
                "$arg": "/note"
              },
              "due": {
                "$fn": "date_add_days",
                "args": [
                  {
                    "$arg": "/start"
                  },
                  30
                ]
              },
              "total": {
                "$fn": "sum",
                "args": [
                  {
                    "$map": {
                      "$step": "before",
                      "pointer": "/data/result/items"
                    },
                    "value": {
                      "$fn": "multiply",
                      "args": [
                        {
                          "$item": "/quantity"
                        },
                        {
                          "$item": "/price"
                        }
                      ]
                    }
                  }
                ]
              },
              "version": {
                "$step": "before",
                "pointer": "/data/result/revision"
              }
            }
          }
        },
        "allowed_body_fields": [
          "method",
          "params"
        ]
      },
      "verify": [
        {
          "id": "after",
          "operation": "detail",
          "arguments": {
            "body": {
              "method": "task.get",
              "params": {
                "key": {
                  "$arg": "/id"
                }
              }
            }
          },
          "assertions": [
            {
              "pointer": "/data/result/key",
              "op": "eq",
              "value": {
                "$arg": "/id"
              }
            },
            {
              "pointer": "/data/result/phase",
              "op": "eq",
              "value": "approved"
            },
            {
              "pointer": "/data/result/note",
              "op": "eq",
              "value": {
                "$arg": "/note"
              }
            },
            {
              "pointer": "/data/result/due",
              "op": "eq",
              "value": {
                "$fn": "date_add_days",
                "args": [
                  {
                    "$arg": "/start"
                  },
                  30
                ]
              }
            },
            {
              "pointer": "/data/result/total",
              "op": "eq",
              "value": {
                "$fn": "sum",
                "args": [
                  {
                    "$map": {
                      "$step": "before",
                      "pointer": "/data/result/items"
                    },
                    "value": {
                      "$fn": "multiply",
                      "args": [
                        {
                          "$item": "/quantity"
                        },
                        {
                          "$item": "/price"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "pointer": "/data/result/revision",
              "op": "gt",
              "value": {
                "$step": "before",
                "pointer": "/data/result/revision"
              }
            }
          ]
        }
      ],
      "lock_key": {
        "$arg": "/id"
      }
    }
  ],
  "trials": {
    "read": [
      {
        "arguments": {
          "id": "101"
        },
        "assertions": [
          {
            "pointer": "/id",
            "op": "eq",
            "value": "101"
          },
          {
            "pointer": "/total",
            "op": "eq",
            "value": 25
          }
        ]
      },
      {
        "arguments": {
          "id": "102"
        },
        "assertions": [
          {
            "pointer": "/id",
            "op": "eq",
            "value": "102"
          },
          {
            "pointer": "/total",
            "op": "eq",
            "value": 41
          }
        ]
      }
    ],
    "approve": [
      {
        "arguments": {
          "id": "101",
          "note": "trial 101",
          "start": "2026-10-23"
        },
        "assertions": [
          {
            "pointer": "/body",
            "op": "eq",
            "value": {
              "method": "task.decide",
              "params": {
                "key": "101",
                "decision": "approved",
                "note": "trial 101",
                "due": "2026-11-22",
                "total": 25.0,
                "version": 1
              }
            }
          }
        ]
      },
      {
        "arguments": {
          "id": "102",
          "note": "trial 102",
          "start": "2026-10-23"
        },
        "assertions": [
          {
            "pointer": "/body",
            "op": "eq",
            "value": {
              "method": "task.decide",
              "params": {
                "key": "102",
                "decision": "approved",
                "note": "trial 102",
                "due": "2026-11-22",
                "total": 41.0,
                "version": 1
              }
            }
          }
        ]
      }
    ]
  }
}
